# Static configuration only. Back up using scripts/backup_static_config.sh.
# Never add OAuth refresh tokens or host-derived runtime identity values here.
MARIADB_USER=cycling
MARIADB_PASSWORD=replace-me
MARIADB_MCP_READER_USER=cycling_mcp_reader
MARIADB_MCP_READER_PASSWORD=replace-me
MARIADB_GRAFANA_READER_USER=cycling_grafana_reader
MARIADB_GRAFANA_READER_PASSWORD=replace-me
MARIADB_ROOT_PASSWORD=replace-me
MARIADB_PORT=3306

# Grafana is exposed only on this explicit LAN address. Do not use 0.0.0.0.
GRAFANA_BIND_ADDRESS=192.0.2.10
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# Static OAuth application identity; mutable refresh tokens belong only in
# /srv/cycling/config/platform/runtime.Renviron.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=


# Existing cycling-platform application and outer-wrapper destination.
NTFY_TOPIC=
# Dedicated cycling-analytics runtime-wrapper destination. Never fall back to
# NTFY_TOPIC, because the two notification streams have different owners.
CYCLING_ANALYTICS_NTFY_TOPIC=
# Optional; defaults to https://ntfy.sh.
NTFY_BASE_URL=
