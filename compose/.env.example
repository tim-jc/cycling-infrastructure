MARIADB_USER=cycling
MARIADB_PASSWORD=replace-me
MARIADB_ROOT_PASSWORD=replace-me
MARIADB_PORT=3306

# Mutable refresh tokens belong in /srv/cycling/config/platform/runtime.Renviron.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# Docker can't identify machine name from within a container, specify here instead (e.g. cycling-prod)
CYCLING_PLATFORM_EXECUTION_HOST=

NTFY_TOPIC=
