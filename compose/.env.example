# Static configuration only. Back up using scripts/backup_static_config.sh.
# Never add OAuth refresh tokens or host-derived runtime identity values here.
MARIADB_USER=cycling
MARIADB_PASSWORD=replace-me
MARIADB_ROOT_PASSWORD=replace-me
MARIADB_PORT=3306

# Static OAuth application identity; mutable refresh tokens belong only in
# /srv/cycling/config/platform/runtime.Renviron.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=


NTFY_TOPIC=
# Optional; defaults to https://ntfy.sh.
NTFY_BASE_URL=
